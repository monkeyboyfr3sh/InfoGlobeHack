{
  "about": [
    "Golden test vectors for live values: what the globe must show (C: clock_values.c + live_values.c) and the preview must show (values.js).",
    "Checked by values.vectors.test.js against both. Each vector: an instant (`at` in UTC, or `local` wall time in the zone), the template `t`, the `expect`ed text,",
    "and optionally `loc` [lat, lon], `colon` (a frame's blinkColon), `steady` (no blinking) and `vars` (pushed values). Group fields are defaults for its vectors.",
    "{ip} is 10.0.0.5. Sunrise/sunset expectations come from the NOAA algorithm both sides use; they agree with published almanac times within about a minute."
  ],
  "zone": "America/Chicago",
  "groups": [
    {
      "name": "matches the real globe (from the API check on 2 Nov 2026)",
      "vectors": [
        { "local": "2026-11-02 21:58:07.100", "t": "{clock}", "expect": "09:58 PM" },
        { "local": "2026-11-02 21:58:07.700", "t": "{clock}", "expect": "09 58 PM" },
        { "local": "2026-11-02 21:58:07.100", "t": "{time} {date}", "expect": "9:58 Mon 02 Nov" },
        { "local": "2026-11-02 21:58:07.100", "t": "{time24}|{ampm}|{sec}|{day}|{dd}|{month}|{mon}|{year}", "expect": "21:58|PM|07|Monday|02|November|Nov|2026" },
        { "local": "2026-11-02 21:58:07.100", "t": "{ip} {nope}", "expect": "10.0.0.5 {nope}" },
        { "local": "2026-11-02 22:38:55.100", "t": "{fuzzy}|{words}|{roman}|{binary}", "expect": "TWENTY TO ELEVEN|TEN THIRTY EIGHT|X:XXXVIII|10110:100110" },
        { "local": "2026-11-02 22:38:55.100", "t": "{clock:24} {clock:sx}", "expect": "22:38 10:38:55" },
        { "local": "2026-11-02 22:38:55.100", "t": "{until:12-25}|{doy} {week}", "expect": "53|306 45" }
      ]
    },
    {
      "name": "midnight, noon and the 12-hour wraparound",
      "vectors": [
        { "local": "2026-01-15 00:00:00.100", "t": "{clock}|{clock:24}|{clock:s}|{clock:x}", "expect": "12:00 AM|00:00|12:00:00 AM|12:00" },
        { "local": "2026-01-15 00:00:00.100", "t": "{time}|{time24}|{ampm}", "expect": "12:00|00:00|AM" },
        { "local": "2026-01-15 00:00:00.100", "t": "{words}|{fuzzy}|{roman}|{binary}|{decimal}", "expect": "TWELVE O'CLOCK|MIDNIGHT|XII:N|00000:000000|0:00" },
        { "local": "2026-01-15 00:00:00.100", "t": "{bar:day}|{pct:day}", "expect": "----------|0" },
        { "local": "2026-01-15 00:59:00.100", "t": "{time}|{words}|{roman}|{fuzzy}", "expect": "12:59|TWELVE FIFTY NINE|XII:LIX|ONE O'CLOCK" },
        { "local": "2026-01-15 01:00:00.100", "t": "{clock}|{time}", "expect": "01:00 AM|1:00" },
        { "local": "2026-01-15 11:59:59.100", "t": "{clock}|{clock:s}|{ampm}|{time24}", "expect": "11:59 AM|11:59:59 AM|AM|11:59" },
        { "local": "2026-01-15 12:00:00.100", "t": "{clock}|{time}|{time24}|{ampm}", "expect": "12:00 PM|12:00|12:00|PM" },
        { "local": "2026-01-15 12:00:00.100", "t": "{fuzzy}|{words}|{binary}|{decimal}", "expect": "NOON|TWELVE O'CLOCK|01100:000000|5:00" },
        { "local": "2026-01-15 12:00:00.100", "t": "{bar:day}|{pct:day}", "expect": "#####-----|50" },
        { "local": "2026-01-15 12:59:00.100", "t": "{clock}|{roman}", "expect": "12:59 PM|XII:LIX" },
        { "local": "2026-01-15 13:00:00.100", "t": "{clock}|{clock:24}|{time}|{roman}", "expect": "01:00 PM|13:00|1:00|I:N" },
        { "local": "2026-01-15 23:59:59.100", "t": "{clock}|{clock:24s}|{time24}|{decimal}", "expect": "11:59 PM|23:59:59|23:59|9:99" },
        { "local": "2026-01-15 23:59:59.100", "t": "{bar:day}|{pct:day}|{binary}", "expect": "#########-|99|10111:111011" },
        { "local": "2026-01-15 23:59:59.100", "t": "{words}|{roman}|{fuzzy}", "expect": "ELEVEN FIFTY NINE|XI:LIX|MIDNIGHT" }
      ]
    },
    {
      "name": "minutes 0-9 and the number words",
      "vectors": [
        { "local": "2026-01-15 09:00:00.100", "t": "{words}|{roman}|{time}|{clock}", "expect": "NINE O'CLOCK|IX:N|9:00|09:00 AM" },
        { "local": "2026-01-15 09:01:00.100", "t": "{words}|{roman}", "expect": "NINE OH ONE|IX:I" },
        { "local": "2026-01-15 09:04:00.100", "t": "{words}|{roman}", "expect": "NINE OH FOUR|IX:IV" },
        { "local": "2026-01-15 09:05:00.100", "t": "{words}|{roman}|{time}", "expect": "NINE OH FIVE|IX:V|9:05" },
        { "local": "2026-01-15 09:09:00.100", "t": "{words}|{roman}", "expect": "NINE OH NINE|IX:IX" },
        { "local": "2026-01-15 09:10:00.100", "t": "{words}|{roman}", "expect": "NINE TEN|IX:X" },
        { "local": "2026-01-15 09:14:00.100", "t": "{words}|{roman}", "expect": "NINE FOURTEEN|IX:XIV" },
        { "local": "2026-01-15 09:19:00.100", "t": "{words}|{roman}", "expect": "NINE NINETEEN|IX:XIX" },
        { "local": "2026-01-15 09:20:00.100", "t": "{words}|{roman}", "expect": "NINE TWENTY|IX:XX" },
        { "local": "2026-01-15 09:21:00.100", "t": "{words}", "expect": "NINE TWENTY ONE" },
        { "local": "2026-01-15 09:40:00.100", "t": "{words}|{roman}", "expect": "NINE FORTY|IX:XL" },
        { "local": "2026-01-15 09:44:00.100", "t": "{roman}", "expect": "IX:XLIV" },
        { "local": "2026-01-15 09:49:00.100", "t": "{roman}", "expect": "IX:XLIX" },
        { "local": "2026-01-15 09:50:00.100", "t": "{words}|{roman}", "expect": "NINE FIFTY|IX:L" },
        { "local": "2026-01-15 04:04:00.100", "t": "{roman}", "expect": "IV:IV" },
        { "local": "2026-01-15 20:08:00.100", "t": "{roman}|{words}", "expect": "VIII:VIII|EIGHT OH EIGHT" }
      ]
    },
    {
      "name": "fuzzy time rounds to the nearest five minutes (:57:30 is the next hour)",
      "vectors": [
        { "local": "2026-01-15 11:57:30.000", "t": "{fuzzy}", "expect": "NOON" },
        { "local": "2026-01-15 11:57:29.900", "t": "{fuzzy}", "expect": "FIVE TO TWELVE" },
        { "local": "2026-01-15 23:57:30.000", "t": "{fuzzy}", "expect": "MIDNIGHT" },
        { "local": "2026-01-15 23:57:29.900", "t": "{fuzzy}", "expect": "FIVE TO TWELVE" },
        { "local": "2026-01-15 10:57:30.000", "t": "{fuzzy}", "expect": "ELEVEN O'CLOCK" },
        { "local": "2026-01-15 10:02:29.000", "t": "{fuzzy}", "expect": "TEN O'CLOCK" },
        { "local": "2026-01-15 10:02:30.000", "t": "{fuzzy}", "expect": "FIVE PAST TEN" },
        { "local": "2026-01-15 10:07:30.000", "t": "{fuzzy}", "expect": "TEN PAST TEN" },
        { "local": "2026-01-15 10:13:00.000", "t": "{fuzzy}", "expect": "QUARTER PAST TEN" },
        { "local": "2026-01-15 10:17:30.000", "t": "{fuzzy}", "expect": "TWENTY PAST TEN" },
        { "local": "2026-01-15 10:22:30.000", "t": "{fuzzy}", "expect": "TWENTY FIVE PAST TEN" },
        { "local": "2026-01-15 10:32:29.000", "t": "{fuzzy}", "expect": "HALF PAST TEN" },
        { "local": "2026-01-15 10:32:30.000", "t": "{fuzzy}", "expect": "TWENTY FIVE TO ELEVEN" },
        { "local": "2026-01-15 10:37:30.000", "t": "{fuzzy}", "expect": "TWENTY TO ELEVEN" },
        { "local": "2026-01-15 10:45:00.000", "t": "{fuzzy}", "expect": "QUARTER TO ELEVEN" },
        { "local": "2026-01-15 10:47:30.000", "t": "{fuzzy}", "expect": "TEN TO ELEVEN" },
        { "local": "2026-01-15 10:52:30.000", "t": "{fuzzy}", "expect": "FIVE TO ELEVEN" },
        { "local": "2026-01-15 11:52:30.000", "t": "{fuzzy}", "expect": "FIVE TO TWELVE" },
        { "local": "2026-01-15 12:02:29.000", "t": "{fuzzy}", "expect": "NOON" },
        { "local": "2026-01-15 12:30:00.000", "t": "{fuzzy}", "expect": "HALF PAST TWELVE" },
        { "local": "2026-01-15 12:35:00.000", "t": "{fuzzy}", "expect": "TWENTY FIVE TO ONE" },
        { "local": "2026-01-15 00:02:29.000", "t": "{fuzzy}", "expect": "MIDNIGHT" },
        { "local": "2026-01-15 00:10:00.000", "t": "{fuzzy}", "expect": "TEN PAST TWELVE" },
        { "local": "2026-01-01 11:58:00.000", "t": "{fuzzy}", "expect": "NOON" },
        { "local": "2026-01-01 09:13:00.000", "t": "{fuzzy}", "expect": "QUARTER PAST NINE" }
      ]
    },
    {
      "name": "clock options and the colon blink",
      "vectors": [
        { "local": "2026-01-01 09:05:01.000", "t": "{time}", "colon": { "period": 2000, "look": "dot" }, "expect": "9.05", "note": "second half of a 2 s cycle" },
        { "local": "2026-01-01 09:05:01.000", "t": "{time}", "colon": { "period": 0 }, "expect": "9:05" },
        { "local": "2026-01-01 09:05:01.000", "t": "{time}", "colon": { "period": 2000 }, "steady": true, "expect": "9:05" },
        { "local": "2026-01-01 09:05:01.000", "t": "{clock}", "expect": "09:05 AM", "note": "classic 1 s blink, on half" },
        { "local": "2026-01-01 09:05:01.600", "t": "{clock}", "expect": "09 05 AM" },
        { "local": "2026-01-01 09:05:01.600", "t": "{clock:n}|{clock:s}|{clock:24}", "expect": "09:05 AM|09:05:01 AM|09 05" },
        { "local": "2026-01-01 09:05:01.600", "t": "{clock}", "steady": true, "expect": "09:05 AM" },
        { "local": "2026-01-01 09:05:01.600", "t": "{time24}|{time}", "expect": "09:05|9:05", "note": "only {clock} blinks without a frame setting" },
        { "local": "2026-01-01 09:05:01.000", "t": "{clock}", "colon": { "period": 2000, "look": "dot" }, "expect": "09.05 AM" },
        { "local": "2026-01-01 09:05:01.000", "t": "{clock:n}", "colon": { "period": 2000, "look": "hide" }, "expect": "09 05 AM", "note": "the frame setting wins over :n" },
        { "local": "2026-01-01 09:05:01.000", "t": "{clock:s}", "colon": { "period": 2000, "look": "dot" }, "expect": "09.05.01 AM" },
        { "local": "2026-01-01 09:05:01.600", "t": "{clock}", "colon": { "period": 0, "look": "dot" }, "expect": "09:05 AM" },
        { "local": "2026-01-01 09:05:01.000", "t": "{time24}", "colon": { "period": 2000, "look": "dot" }, "expect": "09.05" },
        { "local": "2026-01-01 09:05:01.000", "t": "A:{time}", "colon": { "period": 2000, "look": "dot" }, "expect": "A:9.05", "note": "colons outside values never blink" },
        { "local": "2026-01-01 09:05:00.100", "t": "{clock:x}", "expect": "09:05" },
        { "local": "2026-01-01 21:05:07.100", "t": "{clock:s}|{clock:24s}|{clock:sx}", "expect": "09:05:07 PM|21:05:07|09:05:07" },
        { "local": "2026-01-01 09:00:00.500", "t": "{time}", "colon": { "period": 1001, "look": "dot" }, "expect": "9:00", "note": "on while ms < period/2 = 500.5" },
        { "local": "2026-01-01 09:00:00.501", "t": "{time}", "colon": { "period": 1001, "look": "dot" }, "expect": "9.00" },
        { "local": "2026-01-01 09:00:00.800", "t": "{time}", "colon": { "period": 1500, "look": "hide" }, "expect": "9 00" },
        { "local": "2026-01-01 09:00:00.060", "t": "{time}", "colon": { "period": 100, "look": "dot" }, "expect": "9:00", "note": "the engine treats periods under 200 ms as steady" }
      ]
    },
    {
      "name": "daylight-saving change days (wall-clock values follow the local clock)",
      "vectors": [
        { "at": "2026-03-08T07:59:59.100Z", "t": "{clock:24s}|{bar:day}|{pct:day}|{decimal}", "expect": "01:59:59|----------|8|0:83" },
        { "at": "2026-03-08T07:30:00.100Z", "t": "{until:03:00}", "expect": "1:30", "note": "wall-clock difference; only 30 real minutes" },
        { "at": "2026-03-08T08:00:00.100Z", "t": "{clock}|{pct:day}|{bar:day}|{decimal}|{fuzzy}", "expect": "03:00 AM|12|#---------|1:25|THREE O'CLOCK" },
        { "at": "2026-03-08T08:00:00.100Z", "t": "{unix}|{doy} {date}", "expect": "1772956800|67 Sun 08 Mar" },
        { "at": "2026-11-01T06:30:00.100Z", "t": "{clock}|{time24}", "expect": "01:30 AM|01:30", "note": "01:30 CDT" },
        { "at": "2026-11-01T07:30:00.100Z", "t": "{clock}|{time24}", "expect": "01:30 AM|01:30", "note": "01:30 CST, an hour later" },
