        { "at": "2026-11-01T07:00:00.100Z", "t": "{clock:24s}", "expect": "01:00:00" },
        { "at": "2026-11-01T06:30:00.100Z", "t": "{sunrise} {sunset}", "loc": [41.8781, -87.6298], "expect": "7:23 5:45" },
        { "at": "2026-11-01T09:00:00.100Z", "t": "{sunrise} {sunset}", "loc": [41.8781, -87.6298], "expect": "6:23 4:45" },
        { "zone": "Europe/London", "at": "2026-03-29T00:59:59.100Z", "t": "{clock:24s}", "expect": "00:59:59" },
        { "zone": "Europe/London", "at": "2026-03-29T01:00:00.100Z", "t": "{clock:24s}", "expect": "02:00:00" },
        { "zone": "Europe/London", "at": "2026-03-29T00:30:00.100Z", "t": "{sunrise} {sunset}", "loc": [51.5074, -0.1278], "expect": "5:44 6:28" },
        { "zone": "Europe/London", "at": "2026-03-29T02:00:00.100Z", "t": "{sunrise} {sunset}", "loc": [51.5074, -0.1278], "expect": "6:44 7:28" },
        { "zone": "Australia/Sydney", "at": "2026-04-04T15:30:00.100Z", "t": "{time24}|{doy}", "expect": "02:30|95", "note": "02:30 AEDT" },
        { "zone": "Australia/Sydney", "at": "2026-04-04T16:30:00.100Z", "t": "{time24}|{doy}", "expect": "02:30|95", "note": "02:30 AEST" }
      ]
    },
